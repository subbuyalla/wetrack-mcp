# WeTrack API credentials
WETRACK_BASE_URL=https://wetrack-two.vercel.app
WETRACK_EMAIL=your@email.com
WETRACK_PASSWORD=YourPassword123

# Optional: pre-set a JWT token (if already have one)
# If set, skips auto-login on start. Cleared on 401 and re-login attempted.
WETRACK_TOKEN=

# System auth key for cron/SLA endpoints (ask your WeTrack admin for this)
WETRACK_AUTH_KEY=

# MCP Transport: stdio (default, for Claude Desktop/Cursor) or sse (for HTTP clients)
MCP_TRANSPORT=stdio

# Only used when MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8000
