# WeTrack API URL (Production: https://vtrack-internal.vercel.app | Staging: https://wetrack-two.vercel.app)
WETRACK_BASE_URL=https://vtrack-internal.vercel.app

# Optional: Pre-set WeTrack session token (No credentials stored in .env)
WETRACK_TOKEN=

# System auth key for cron/SLA endpoints (optional, admin only)
WETRACK_AUTH_KEY=

# MCP Transport: stdio (for local Claude Desktop / Cursor) or sse (for remote EC2 / HTTP)
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ── Server-Side OAuth 2.1 Authentication (RFC 9470 Protected Resource) ────────
# Required when MCP_TRANSPORT=sse or streamable-http to protect the EC2 endpoint
OAUTH_ENABLED=true
OAUTH_ISSUER_URL=https://login.microsoftonline.com/organizations/v2.0
OAUTH_JWKS_URI=https://login.microsoftonline.com/organizations/discovery/v2.0/keys
OAUTH_AUDIENCE=47722668-aafe-422a-a167-10c32d67c2f0
OAUTH_REQUIRED_SCOPES=mcp:tools
MCP_RESOURCE_SERVER_URL=http://16.112.106.229:8000

